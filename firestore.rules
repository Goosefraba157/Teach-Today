rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isGoogleTeacher() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function teacherOwns(data) {
      return isGoogleTeacher() && data.teacherUid == request.auth.uid;
    }
    function ownsStudent(studentId) {
      return signedIn()
        && get(/databases/$(database)/documents/students/$(studentId)).data.ownerUid == request.auth.uid;
    }
    function teachesStudent(studentId) {
      return teacherOwns(get(/databases/$(database)/documents/students/$(studentId)).data);
    }

    match /studentCodes/{code} {
      allow get: if signedIn() && resource.data.active == true;
      allow list: if teacherOwns(resource.data);
      allow create: if isGoogleTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow update: if teacherOwns(resource.data)
        && request.resource.data.teacherUid == resource.data.teacherUid;
      allow delete: if teacherOwns(resource.data);
    }

    match /studentLinks/{linkId} {
      allow read: if teacherOwns(resource.data)
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.teacherUid is string
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid == request.resource.data.teacherUid;
      allow update: if teacherOwns(resource.data)
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.teacherUid == resource.data.teacherUid);
      allow delete: if teacherOwns(resource.data);
    }

    match /students/{studentId} {
      allow read: if teacherOwns(resource.data)
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.teacherUid is string
        && request.resource.data.loginCode is string
        && get(/databases/$(database)/documents/studentCodes/$(request.resource.data.loginCode)).data.teacherUid == request.resource.data.teacherUid;
      allow update: if (teacherOwns(resource.data)
        && request.resource.data.teacherUid == resource.data.teacherUid)
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.teacherUid == resource.data.teacherUid);
      allow delete: if teacherOwns(resource.data);

      match /activity/{activityId} {
        allow read: if teachesStudent(studentId) || ownsStudent(studentId);
        allow create: if ownsStudent(studentId)
          && request.resource.data.studentId == studentId;
        allow update: if teachesStudent(studentId)
          || (ownsStudent(studentId)
            && request.resource.data.studentId == studentId
            && request.resource.data.originalTranscript == resource.data.originalTranscript);
        allow delete: if teachesStudent(studentId);
      }
    }

    // Existing per-teacher Teach Today backup documents remain private.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /teachTodaySync/{document=**} {
      allow read, write: if false;
    }
  }
}
