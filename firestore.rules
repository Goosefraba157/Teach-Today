rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function ownsStudent(studentId) {
      return signedIn()
        && get(/databases/$(database)/documents/students/$(studentId)).data.ownerUid == request.auth.uid;
    }

    match /studentCodes/{code} {
      allow get: if signedIn();
      allow list, create, update, delete: if isTeacher();
    }

    match /studentLinks/{linkId} {
      allow read: if isTeacher();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isTeacher() || resource.data.ownerUid == request.auth.uid;
      allow delete: if isTeacher();
    }

    match /students/{studentId} {
      allow read: if isTeacher() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isTeacher()
        || (signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid)
        || (signedIn() && !('ownerUid' in resource.data) && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isTeacher();

      match /activity/{activityId} {
        allow read: if isTeacher() || ownsStudent(studentId);
        allow create: if ownsStudent(studentId)
          && request.resource.data.studentId == studentId;
        allow update: if isTeacher()
          || (ownsStudent(studentId)
            && request.resource.data.studentId == studentId
            && request.resource.data.originalTranscript == resource.data.originalTranscript);
        allow delete: if isTeacher();
      }
    }

    // Existing per-teacher Teach Today backup documents remain private.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /teachTodaySync/{document=**} {
      allow read, write: if isTeacher();
    }
  }
}
